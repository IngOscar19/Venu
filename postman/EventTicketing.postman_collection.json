{
  "info": {
    "name": "EventTicketing API",
    "description": "Colección automatizada. Ejecutar con Collection Runner en orden. Los tokens e IDs se guardan automáticamente en variables de colección.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('runId')) {",
          "  pm.collectionVariables.set('runId', Date.now().toString());",
          "}"
        ]
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5272" },
    { "key": "password", "value": "Passw0rd!123" },
    { "key": "adminEmail", "value": "admin@eventticketing.com" },
    { "key": "adminPassword", "value": "Admin123!" },
    { "key": "token", "value": "" },
    { "key": "organizerToken", "value": "" },
    { "key": "customerToken", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "organizerId", "value": "" },
    { "key": "eventTypeId", "value": "" },
    { "key": "eventId", "value": "" },
    { "key": "sectionId", "value": "" },
    { "key": "imageId", "value": "" },
    { "key": "orderId", "value": "" },
    { "key": "ticketId", "value": "" },
    { "key": "ticketCode", "value": "" },
    { "key": "runId", "value": "" }
  ],
  "item": [
    {
      "name": "01 - Auth",
      "item": [
        {
          "name": "Register Organizer",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "const j = pm.response.json();",
            "pm.test('Devuelve token y organizerId', () => { pm.expect(j.token).to.be.a('string'); pm.expect(j.organizerId).to.exist; });",
            "pm.collectionVariables.set('organizerToken', j.token);",
            "pm.collectionVariables.set('organizerId', j.organizerId);"
          ] } }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"org_{{runId}}@test.com\",\n  \"password\": \"{{password}}\",\n  \"firstName\": \"Org\",\n  \"lastName\": \"Tester\",\n  \"role\": \"ORGANIZER\",\n  \"organizerName\": \"Org {{runId}}\",\n  \"organizerDescription\": \"Organizador de pruebas\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          }
        },
        {
          "name": "Register Customer",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.collectionVariables.set('customerToken', pm.response.json().token);"
          ] } }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"cust_{{runId}}@test.com\",\n  \"password\": \"{{password}}\",\n  \"firstName\": \"Cliente\",\n  \"lastName\": \"Tester\",\n  \"role\": \"CUSTOMER\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          }
        },
        {
          "name": "Login Organizer",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "const j = pm.response.json();",
            "pm.expect(j.token).to.be.a('string');",
            "pm.collectionVariables.set('organizerToken', j.token);"
          ] } }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"org_{{runId}}@test.com\",\n  \"password\": \"{{password}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Login Invalid (401)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Credenciales inválidas rechazadas', () => pm.expect(pm.response.code).to.be.oneOf([400, 401]));"
          ] } }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"nadie@test.com\",\n  \"password\": \"incorrecta\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Login Admin",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Login admin (requiere admin sembrado)', () => pm.response.to.have.status(200));",
            "if (pm.response.code === 200) pm.collectionVariables.set('adminToken', pm.response.json().token);"
          ] } }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Me",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('Perfil organizador', () => pm.expect(pm.response.json().role).to.eql('ORGANIZER'));"
          ] } }],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{organizerToken}}", "type": "string" }] },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] }
          }
        },
        {
          "name": "Me sin token (401)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"
          ] } }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] }
          }
        }
      ]
    },
    {
      "name": "02 - Event Types",
      "item": [
        {
          "name": "Get Event Types",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "const j = pm.response.json();",
            "pm.test('Es arreglo', () => pm.expect(j).to.be.an('array'));",
            "if (j.length) pm.collectionVariables.set('eventTypeId', j[0].id);"
          ] } }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/event-types", "host": ["{{baseUrl}}"], "path": ["api", "event-types"] }
          }
        }
      ]
    },
    {
      "name": "03 - Events (Organizer)",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{organizerToken}}", "type": "string" }] },
      "item": [
        {
          "name": "Create Event",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('201 Created', () => pm.response.to.have.status(201));",
            "const j = pm.response.json();",
            "pm.test('Tiene id', () => pm.expect(j.id).to.be.a('string'));",
            "pm.collectionVariables.set('eventId', j.id);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Concierto {{runId}}\",\n  \"description\": \"Evento de prueba automatizada\",\n  \"eventTypeId\": \"{{eventTypeId}}\",\n  \"startDate\": \"2030-01-15T00:00:00Z\",\n  \"endDate\": \"2030-01-15T00:00:00Z\",\n  \"startTime\": \"19:00:00\",\n  \"endTime\": \"23:00:00\",\n  \"venueName\": \"Estadio Central\",\n  \"address\": \"Av. Principal 123\",\n  \"city\": \"Ciudad de Guatemala\",\n  \"state\": \"Guatemala\",\n  \"latitude\": 14.6349,\n  \"longitude\": -90.5069,\n  \"capacity\": 500\n}" },
            "url": { "raw": "{{baseUrl}}/api/events", "host": ["{{baseUrl}}"], "path": ["api", "events"] }
          }
        },
        {
          "name": "Get Event By Id",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('Id coincide', () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('eventId')));"
          ] } }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/events/{{eventId}}", "host": ["{{baseUrl}}"], "path": ["api", "events", "{{eventId}}"] }
          }
        },
        {
          "name": "Update Event",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('Nombre actualizado', () => pm.expect(pm.response.json().name).to.include('Actualizado'));"
          ] } }],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Concierto Actualizado {{runId}}\",\n  \"description\": \"Descripción actualizada\",\n  \"eventTypeId\": \"{{eventTypeId}}\",\n  \"startDate\": \"2030-01-15T00:00:00Z\",\n  \"endDate\": \"2030-01-15T00:00:00Z\",\n  \"startTime\": \"19:00:00\",\n  \"endTime\": \"23:30:00\",\n  \"venueName\": \"Estadio Central\",\n  \"address\": \"Av. Principal 123\",\n  \"city\": \"Ciudad de Guatemala\",\n  \"state\": \"Guatemala\",\n  \"latitude\": 14.6349,\n  \"longitude\": -90.5069,\n  \"capacity\": 500\n}" },
            "url": { "raw": "{{baseUrl}}/api/events/{{eventId}}", "host": ["{{baseUrl}}"], "path": ["api", "events", "{{eventId}}"] }
          }
        },
        {
          "name": "Add Section",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.collectionVariables.set('sectionId', pm.response.json().id);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"General\",\n  \"description\": \"Acceso general\",\n  \"capacity\": 200,\n  \"basePrice\": 150.00\n}" },
            "url": { "raw": "{{baseUrl}}/api/events/{{eventId}}/sections", "host": ["{{baseUrl}}"], "path": ["api", "events", "{{eventId}}", "sections"] }
          }
        },
        {
          "name": "Update Section",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('Precio actualizado', () => pm.expect(pm.response.json().basePrice).to.eql(175));"
          ] } }],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"General\",\n  \"description\": \"Acceso general\",\n  \"capacity\": 200,\n  \"basePrice\": 175.00\n}" },
            "url": { "raw": "{{baseUrl}}/api/events/{{eventId}}/sections/{{sectionId}}", "host": ["{{baseUrl}}"], "path": ["api", "events", "{{eventId}}", "sections", "{{sectionId}}"] }
          }
        },
        {
          "name": "Add Image (URL)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.collectionVariables.set('imageId', pm.response.json().id);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"url\": \"https://picsum.photos/800/600\",\n  \"type\": \"POSTER\",\n  \"order\": 0\n}" },
            "url": { "raw": "{{baseUrl}}/api/events/{{eventId}}/images", "host": ["{{baseUrl}}"], "path": ["api", "events", "{{eventId}}", "images"] }
          }
        },
        {
          "name": "Upload Image (manual: seleccionar archivo)",
          "request": {
            "method": "POST",
            "header": [],
            "body": { "mode": "formdata", "formdata": [
              { "key": "file", "type": "file", "src": [] },
              { "key": "type", "value": "GALLERY", "type": "text" },
              { "key": "order", "value": "1", "type": "text" }
            ] },
            "url": { "raw": "{{baseUrl}}/api/events/{{eventId}}/images/upload", "host": ["{{baseUrl}}"], "path": ["api", "events", "{{eventId}}", "images", "upload"] },
            "description": "Requiere seleccionar un archivo manualmente. Omitir en el Runner (desmarcar)."
          }
        },
        {
          "name": "Delete Image",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('204 No Content', () => pm.response.to.have.status(204));"
          ] } }],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/events/{{eventId}}/images/{{imageId}}", "host": ["{{baseUrl}}"], "path": ["api", "events", "{{eventId}}", "images", "{{imageId}}"] }
          }
        },
        {
          "name": "Publish Event",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('204 No Content', () => pm.response.to.have.status(204));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/events/{{eventId}}/publish", "host": ["{{baseUrl}}"], "path": ["api", "events", "{{eventId}}", "publish"] }
          }
        },
        {
          "name": "Get My Events",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "const id = pm.collectionVariables.get('eventId');",
            "pm.test('Contiene el evento creado', () => pm.expect(pm.response.json().some(e => e.id === id)).to.be.true);"
          ] } }],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/events/mine", "host": ["{{baseUrl}}"], "path": ["api", "events", "mine"] }
          }
        },
        {
          "name": "Dashboard Stats",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "const j = pm.response.json();",
            "pm.test('Estructura de stats', () => { pm.expect(j).to.have.property('totalEvents'); pm.expect(j).to.have.property('totalRevenue'); });"
          ] } }],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/dashboard/stats", "host": ["{{baseUrl}}"], "path": ["api", "dashboard", "stats"] }
          }
        }
      ]
    },
    {
      "name": "04 - Events (Público)",
      "auth": { "type": "noauth" },
      "item": [
        {
          "name": "List Events",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('Es arreglo', () => pm.expect(pm.response.json()).to.be.an('array'));"
          ] } }],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/events?search=Concierto&city=&status=", "host": ["{{baseUrl}}"], "path": ["api", "events"], "query": [
              { "key": "search", "value": "Concierto" },
              { "key": "city", "value": "", "disabled": true },
              { "key": "fromDate", "value": "", "disabled": true },
              { "key": "status", "value": "", "disabled": true }
            ] }
          }
        },
        {
          "name": "Get Event inexistente (404)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('404 Not Found', () => pm.response.to.have.status(404));"
          ] } }],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/events/00000000-0000-0000-0000-000000000000", "host": ["{{baseUrl}}"], "path": ["api", "events", "00000000-0000-0000-0000-000000000000"] }
          }
        }
      ]
    },
    {
      "name": "05 - Tickets (Customer)",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{customerToken}}", "type": "string" }] },
      "item": [
        {
          "name": "Purchase Tickets",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('201 Created', () => pm.response.to.have.status(201));",
            "const j = pm.response.json();",
            "pm.collectionVariables.set('orderId', j.id);",
            "const t = (j.tickets || j.items || [])[0];",
            "if (t) { pm.collectionVariables.set('ticketId', t.id); if (t.ticketCode) pm.collectionVariables.set('ticketCode', t.ticketCode); }"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"eventId\": \"{{eventId}}\",\n  \"items\": [\n    {\n      \"eventSectionId\": \"{{sectionId}}\",\n      \"attendeeName\": \"Juan Pérez\",\n      \"attendeeEmail\": \"juan_{{runId}}@test.com\"\n    }\n  ]\n}" },
            "url": { "raw": "{{baseUrl}}/api/tickets/purchase", "host": ["{{baseUrl}}"], "path": ["api", "tickets", "purchase"] }
          }
        },
        {
          "name": "My Orders",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('Contiene la orden', () => pm.expect(pm.response.json().some(o => o.id === pm.collectionVariables.get('orderId'))).to.be.true);"
          ] } }],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/tickets/my-orders", "host": ["{{baseUrl}}"], "path": ["api", "tickets", "my-orders"] }
          }
        },
        {
          "name": "Get Order By Id",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));"
          ] } }],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/tickets/orders/{{orderId}}", "host": ["{{baseUrl}}"], "path": ["api", "tickets", "orders", "{{orderId}}"] }
          }
        },
        {
          "name": "My Tickets",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "const j = pm.response.json();",
            "pm.test('Al menos un ticket', () => pm.expect(j.length).to.be.above(0));",
            "if (j.length) { pm.collectionVariables.set('ticketId', j[0].id); pm.collectionVariables.set('ticketCode', j[0].ticketCode); }"
          ] } }],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/tickets/my-tickets", "host": ["{{baseUrl}}"], "path": ["api", "tickets", "my-tickets"] }
          }
        },
        {
          "name": "Get Ticket By Id",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('Tiene ticketCode', () => pm.expect(pm.response.json().ticketCode).to.be.a('string'));"
          ] } }],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/tickets/{{ticketId}}", "host": ["{{baseUrl}}"], "path": ["api", "tickets", "{{ticketId}}"] }
          }
        }
      ]
    },
    {
      "name": "06 - Access (Check-in)",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{organizerToken}}", "type": "string" }] },
      "item": [
        {
          "name": "Check-in válido",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('Success true', () => pm.expect(pm.response.json().success).to.be.true);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"ticketCode\": \"{{ticketCode}}\",\n  \"eventId\": \"{{eventId}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/access/check-in", "host": ["{{baseUrl}}"], "path": ["api", "access", "check-in"] }
          }
        },
        {
          "name": "Check-in repetido (rechazado)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Segundo uso rechazado', () => {",
            "  if (pm.response.code === 200) pm.expect(pm.response.json().success).to.be.false;",
            "  else pm.expect(pm.response.code).to.be.within(400, 409);",
            "});"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"ticketCode\": \"{{ticketCode}}\",\n  \"eventId\": \"{{eventId}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/access/check-in", "host": ["{{baseUrl}}"], "path": ["api", "access", "check-in"] }
          }
        }
      ]
    },
